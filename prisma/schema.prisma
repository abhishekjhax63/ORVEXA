// ===========================================================================
// Phase 10 — Advanced patient care and wellness ecosystem
// ===========================================================================
//
// Three rules run through everything below.
//
// 1. Provenance is a column, not a guess. Anything a person can read carries a
//    `source` that says whether the value was typed by the person, imported from
//    a device, reported by a partner, or recorded by a clinician. A clinician
//    verification is additionally stamped with who verified it and when.
//
// 2. There is no wellness score. `WellnessEntry` holds a value and a unit; the
//    platform never reduces a person's week into a single number that could be
//    mistaken for a clinical finding, and never states or implies that a
//    wearable reading should change a prescribed treatment.
//
// 3. Family access is a record, not a flag. `CaregiverAccess` is granted by one
//    account, accepted by the other, and can be reviewed and revoked by either.
//    Nothing is shared with a relative because they share a surname.

// ---------------------------------------------------------------------------
// Phase 10 enums
// ---------------------------------------------------------------------------

/// Where a value came from. Present on every modelled health observation so the
/// UI can label it and so a clinician reading it knows how much to trust it.
enum HealthRecordSource {
  /// Typed by the person (or their caregiver) through the app.
  USER_ENTERED
  /// Imported from a connected device or an imported export file.
  DEVICE_IMPORTED
  /// Recorded by a clinician in a consultation or a hospital workspace.
  CLINICIAN_RECORDED
  /// Published by a partner (a laboratory report, a pharmacy label).
  PARTNER_REPORTED
  /// Extracted from a document the person uploaded.
  DOCUMENT_UPLOADED
}

enum CaregiverAccessStatus {
  /// Offered by the owner; the caregiver has not accepted yet.
  INVITED
  ACTIVE
  SUSPENDED
  REVOKED
  EXPIRED
}

/// What a caregiver may do, as an explicit list rather than a role name, so a
/// person can hand over appointment booking without handing over the record.
enum CaregiverScope {
  VIEW_PROFILE
  BOOK_APPOINTMENTS
  VIEW_RECORDS
  MANAGE_MEDICATIONS
  MANAGE_REMINDERS
