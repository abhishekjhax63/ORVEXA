/// The hospital's own price list. A line on an invoice copies the price and tax
/// rate from here inside the billing transaction; the client never sends either.
model HospitalChargeItem {
  id             String         @id @default(cuid())
  hospitalId     String
  code           String
  name           String
  category       ChargeCategory @default(OTHER)
  description    String?
  unitPricePaise Int
  /// Tax rate in basis points (1800 = 18%).
  taxRateBp      Int            @default(0)
  isActive       Boolean        @default(true)
  effectiveFrom  DateTime?
  effectiveTo    DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  hospital Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)

  @@unique([hospitalId, code])
  @@index([hospitalId, category, isActive])
}

model HospitalInvoice {
  id              String                @id @default(cuid())
  hospitalId      String
  patientId       String
  admissionId     String?
  opdVisitId      String?
  invoiceNumber   String
  status          HospitalInvoiceStatus @default(DRAFT)
  currency        String                @default("INR")
  /// All totals are recomputed from the lines, server-side, in paise.
  subtotalPaise   Int                   @default(0)
  discountPaise   Int                   @default(0)
  taxPaise        Int                   @default(0)
  totalPaise      Int                   @default(0)
  amountPaidPaise Int                   @default(0)
