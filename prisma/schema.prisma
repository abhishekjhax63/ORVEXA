// ---------------------------------------------------------------------------
// Module A — caregiver access
// ---------------------------------------------------------------------------

/// A caregiver's access to another account's records.
///
/// Created by the owner as `INVITED` with an explicit scope list and a named
/// consent record, and it does nothing until the caregiver accepts. Either side
/// can revoke it, and a revoked row is kept rather than deleted so the history of
/// who could see what survives the revocation.
model CaregiverAccess {
  id              String                @id @default(cuid())
  ownerUserId     String
  /// Null while the invitation is open and the caregiver has not signed up.
  caregiverUserId String?
  invitedEmail    String?
  relationship    FamilyRelationship
  status          CaregiverAccessStatus @default(INVITED)
  /// The explicit list of things this caregiver may do. Never implied by the
  /// relationship: a spouse who may book appointments is not thereby allowed to
  /// read the record.
  scopes          CaregiverScope[]
  /// The consent row that authorises this access. Access without a consent
  /// record is a bug, not a default.
  consentRecordId String?
  note            String?
  invitedById     String
  invitedAt       DateTime              @default(now())
  acceptedAt      DateTime?
  reviewedAt      DateTime?
  lastAccessedAt  DateTime?
  /// Set when the owner wants the access to lapse on its own.
  expiresAt       DateTime?
  revokedAt       DateTime?
  revokedById     String?
  revokedReason   String?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  owner     User  @relation("CaregiverAccessOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)
  caregiver User? @relation("CaregiverAccessCaregiver", fields: [caregiverUserId], references: [id], onDelete: SetNull)

  @@unique([ownerUserId, caregiverUserId])
  @@index([caregiverUserId, status])
  @@index([ownerUserId, status])
  @@index([expiresAt])
}

// ---------------------------------------------------------------------------
// Module B — medical history, allergies, immunizations and the document vault
// ---------------------------------------------------------------------------

/// The document vault. A row is metadata plus a pointer into private object
/// storage; the bytes are never public and are only ever served through a short
/// lived signed URL issued to somebody the access check has already passed.
model HealthDocument {
  id             String               @id @default(cuid())
  ownerUserId    String
  /// The relative this document belongs to, when it is not the account holder's.
  familyMemberId String?
  kind           HealthDocumentKind
  status         HealthDocumentStatus @default(ACTIVE)
  title          String
  description    String?
  /// Private object key. Never rendered, never logged.
  storageKey     String
  fileName       String?
  mimeType       String
  sizeBytes      Int
  source         HealthRecordSource   @default(DOCUMENT_UPLOADED)
  /// Who or what issued the document, e.g. "Apollo Diagnostics" — free text the
  /// owner enters, so it is clearly a label and not a verified claim.
  issuedByLabel  String?
  issuedOn       DateTime?
  /// Marks clinical content, so the read path records an audit row and the UI
  /// can warn before sharing.
  isSensitive    Boolean              @default(true)
  uploadedById   String
  deletedAt      DateTime?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  owner User @relation("HealthDocumentOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)

  @@index([ownerUserId, status, createdAt])
  @@index([ownerUserId, kind])
  @@index([familyMemberId])
}

/// The personal health timeline.
///
/// Append-only from the app's point of view: an event is written when something
/// actually happened elsewhere in the platform, and `refType`/`refId` point back
/// at the row that is the source of truth. The timeline is a view of the record,
/// never a second copy of it, and nothing here is authored directly by a client.
model HealthTimelineEvent {
  id             String                  @id @default(cuid())
  ownerUserId    String
  familyMemberId String?
  kind           HealthTimelineEventKind
  source         HealthRecordSource
  title          String
  summary        String?
  /// When the event happened, as opposed to when the row was written.
  occurredAt     DateTime
  /// The model this event refers to, e.g. "LabReport", plus its id. Kept as
  /// loose strings so the timeline can point at any module without a foreign key
  /// per module.
  refType        String?
  refId          String?
  documentId     String?
  metadata       Json?
  createdAt      DateTime                @default(now())

  owner User @relation("HealthTimelineOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)

  @@index([ownerUserId, occurredAt])
  @@index([ownerUserId, kind, occurredAt])
  @@index([refType, refId])
}

model AllergyRecord {
  id             String             @id @default(cuid())
  ownerUserId    String
  familyMemberId String?
  /// The allergen as recorded, e.g. "Penicillin".
  substance      String
  reaction       String?
  severity       AllergySeverity    @default(UNKNOWN)
  source         HealthRecordSource
  /// Set only for `CLINICIAN_RECORDED` rows. A self-reported allergy is never
  /// shown as clinician-verified.
  verifiedById   String?
  verifiedAt     DateTime?
  recordedById   String
  notes          String?
  isActive       Boolean            @default(true)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  owner User @relation("AllergyOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)

  @@index([ownerUserId, isActive])
  @@index([familyMemberId])
}

model ImmunizationRecord {
  id                  String             @id @default(cuid())
  ownerUserId         String
  familyMemberId      String?
  vaccineName         String
  /// e.g. "Dose 2", "Booster".
  doseLabel           String?
  administeredOn      DateTime
  administeredByLabel String?
  facilityLabel       String?
  batchNumber         String?
  source              HealthRecordSource
  verifiedById        String?
  verifiedAt          DateTime?
  documentId          String?
  notes               String?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  owner User @relation("ImmunizationOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)

  @@index([ownerUserId, administeredOn])
  @@index([familyMemberId])
}

model MedicalHistoryItem {
  id             String                 @id @default(cuid())
  ownerUserId    String
  familyMemberId String?
  category       MedicalHistoryCategory
  label          String
  details        String?
  onsetOn        DateTime?
  resolvedOn     DateTime?
  source         HealthRecordSource
  verifiedById   String?
  verifiedAt     DateTime?
  recordedById   String
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  owner User @relation("MedicalHistoryOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)

  @@index([ownerUserId, category])
  @@index([familyMemberId])
}

// ---------------------------------------------------------------------------
// Module C — reminders
// ---------------------------------------------------------------------------

/// Per-account reminder delivery preferences.
///
/// `timezone` is an IANA name and is what every reminder's local time is
/// resolved against, so a person who travels is reminded at 9am where they are
/// rather than at 9am where the server is. Quiet hours are in local time.
model ReminderPreference {
  id                    String                @id @default(cuid())
  userId                String                @unique
  timezone              String                @default("Asia/Kolkata")
  channels              CareReminderChannel[] @default([IN_APP])
  quietHoursStartMinute Int?
  quietHoursEndMinute   Int?
  defaultLeadMinutes    Int                   @default(15)
  /// The account-wide off switch. Off means the scheduler skips everything for
  /// this person, which is what "stop reminding me" has to actually do.
  remindersEnabled      Boolean               @default(true)
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// A reminder the person configured.
///
/// `dedupeKey` is unique per owner, so re-running a generator (for example the
/// vaccination planner) cannot create the same reminder twice; it updates the
/// existing one instead.
model Reminder {
  id                   String               @id @default(cuid())
  ownerUserId          String
  familyMemberId       String?
  kind                 ReminderKind
  title                String
  notes                String?
  scheduleKind         ReminderScheduleKind
  /// First occurrence, in UTC. Local time is derived from `timezone`.
  startAt              DateTime
  /// Minutes past local midnight, for DAILY/WEEKLY/MONTHLY schedules.
  localMinuteOfDay     Int?
  /// 0 = Sunday, matching `Date.getUTCDay()`.
  daysOfWeek           Int[]
  intervalMinutes      Int?
  timezone             String               @default("Asia/Kolkata")
  nextDueAt            DateTime
  lastFiredAt          DateTime?
  status               CareReminderStatus   @default(ACTIVE)
  channel              CareReminderChannel  @default(IN_APP)
  /// Nullable and unique per owner: the duplicate guard described above.
  dedupeKey            String?
  /// Set when this reminder was generated from a plan or a schedule, so the
  /// person can see where it came from.
  preventiveCarePlanId String?
  medicationScheduleId String?
  createdById          String
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  owner      User               @relation("ReminderOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)
  dispatches ReminderDispatch[]

  @@unique([ownerUserId, dedupeKey])
  @@index([status, nextDueAt])
  @@index([ownerUserId, status])
}

/// One attempt to deliver one occurrence.
///
/// `@@unique([reminderId, scheduledFor])` is the duplicate-prevention guarantee:
/// two workers racing over the same due reminder cannot both send it, because
/// the second insert violates the constraint and is recorded as
/// `SUPPRESSED_DUPLICATE`.
model ReminderDispatch {
  id             String                  @id @default(cuid())
  reminderId     String
  /// The occurrence this dispatch is for, in UTC. Truncated to the minute.
  scheduledFor   DateTime
  channel        CareReminderChannel
  outcome        ReminderDispatchOutcome @default(QUEUED)
  /// Local time the dispatch was resolved against, stamped so a quiet-hours
  /// suppression can be explained after the fact.
  localTimeLabel String?
  detail         String?
  attemptedAt    DateTime                @default(now())

  reminder Reminder @relation(fields: [reminderId], references: [id], onDelete: Cascade)

  @@unique([reminderId, scheduledFor])
  @@index([reminderId, attemptedAt])
  @@index([outcome, attemptedAt])
}

// ---------------------------------------------------------------------------
// Module D — preventive health and care programmes
// ---------------------------------------------------------------------------

/// A planned vaccination, screening or checkup.
///
/// `guidanceLabel` and `guidanceSourceLabel` record where the suggestion came
/// from as free text ("National Immunisation Schedule", "clinician advice at
/// visit on 12 Mar"). ORVEXA does not present a schedule of its own as medical
/// advice, and never states that a person should or should not be screened — it
/// plans what a professional or a published national schedule already says.
model PreventiveCarePlan {
  id                  String               @id @default(cuid())
  ownerUserId         String
  familyMemberId      String?
  kind                PreventiveCareKind
  status              PreventiveCareStatus @default(PLANNED)
  title               String
  /// Who suggested it. Required, so no plan appears without an attributable
  /// source.
  guidanceSourceLabel String
  guidanceNote        String?
  dueOn               DateTime?
  completedOn         DateTime?
  /// Links to the record that discharged the plan, e.g. the immunization row.
  completedRefType    String?
  completedRefId      String?
  reminderId          String?
  createdById         String
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  owner User @relation("PreventiveCarePlanOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)

  @@index([ownerUserId, status, dueOn])
  @@index([familyMemberId])
}

/// An enrolment in a structured care programme: maternity, child health, senior
/// care, a chronic condition, or rehabilitation.
model CareProgramEnrollment {
  id               String            @id @default(cuid())
  ownerUserId      String
  familyMemberId   String?
  kind             CareProgramKind
  status           CareProgramStatus @default(ACTIVE)
  title            String
  /// Who is coordinating, e.g. "Dr. Rao (OBG)" or "Community nurse, Ward 4".
  coordinatorLabel String?
  enrolledOn       DateTime          @default(now())
  endedOn          DateTime?
  /// Programme-specific fields (gestational week, condition name, care tier).
  details          Json?
  notes            String?
  createdById      String
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  owner User @relation("CareProgramOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)

  @@index([ownerUserId, status])
  @@index([familyMemberId])
}

// ---------------------------------------------------------------------------
// Module E — medication schedules and adherence
// ---------------------------------------------------------------------------

/// A medicine a person is taking, and when.
///
/// When `source` is `CLINICIAN_RECORDED` the schedule is the prescriber's and is
/// locked: the service refuses to let it be edited or stopped by the patient or
/// by an import. Stopping a prescribed medicine is a clinical decision, so the
/// app can only record that the person has stopped taking it, not rewrite the
/// prescription.
model MedicationSchedule {
  id                     String                   @id @default(cuid())
  ownerUserId            String
  familyMemberId         String?
  /// Set when this schedule was created from a prescription the platform holds.
  prescriptionId         String?
  hospitalPrescriptionId String?
  medicineName           String
  strengthLabel          String?
  dosageForm             String?
  doseLabel              String
  /// Human-readable frequency, e.g. "1-0-1" or "every 8 hours".
  frequencyLabel         String
  /// Local times of day, as minutes past midnight.
  localTimesOfDay        Int[]
  timezone               String                   @default("Asia/Kolkata")
  startOn                DateTime
  endOn                  DateTime?
  instructions           String?
  /// Free-text name of the prescriber. Kept as text because the prescriber may
  /// be outside ORVEXA.
  prescriberLabel        String?
  source                 HealthRecordSource
  status                 MedicationScheduleStatus @default(ACTIVE)
  stoppedReason          String?
  createdById            String
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @updatedAt

  owner User                @relation("MedicationScheduleOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)
  doses MedicationDoseLog[]

  @@index([ownerUserId, status])
  @@index([familyMemberId])
}

/// One logged dose.
///
/// `@@unique([scheduleId, scheduledFor])` makes a dose occur once: a double tap
/// on "taken" updates the same row rather than logging twice, and the adherence
/// figure the UI shows cannot be inflated by repeated taps.
model MedicationDoseLog {
  id              String               @id @default(cuid())
  scheduleId      String
  scheduledFor    DateTime
  status          MedicationDoseStatus @default(SCHEDULED)
  takenAt         DateTime?
  actualDoseLabel String?
  recordedById    String?
  source          HealthRecordSource   @default(USER_ENTERED)
  notes           String?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  schedule   MedicationSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  recordedBy User?              @relation("MedicationDoseLogRecorder", fields: [recordedById], references: [id], onDelete: SetNull)

  @@unique([scheduleId, scheduledFor])
  @@index([scheduleId, status])
}

// ---------------------------------------------------------------------------
// Module F — wellness tracking
// ---------------------------------------------------------------------------

/// A single wellness observation.
///
/// Deliberately a value plus a unit plus a source. There is no derived score and
/// no per-person "wellness index", because a number like that reads as a
/// clinical finding and is not one.
model WellnessEntry {
  id                 String             @id @default(cuid())
  ownerUserId        String
  familyMemberId     String?
  category           WellnessCategory
  unit               WellnessUnit       @default(NONE)
  valueNumeric       Decimal?           @db.Decimal(12, 3)
  valueText          String?
  /// When the measurement relates to, which for an imported reading is the
  /// device's own timestamp rather than the time of import.
  recordedAt         DateTime
  source             HealthRecordSource
  /// Set only when `source` is `DEVICE_IMPORTED`, pointing at the sync that
  /// brought it in, so an imported value is always traceable to a sync.
  deviceConnectionId String?
  deviceSyncRecordId String?
  /// A clinician can confirm a reading. Only then is it shown as verified; a
  /// device value is never silently promoted.
  verifiedById       String?
  verifiedAt         DateTime?
  notes              String?
  createdById        String
  createdAt          DateTime           @default(now())

  owner User @relation("WellnessEntryOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)

  @@index([ownerUserId, category, recordedAt])
  @@index([ownerUserId, recordedAt])
  @@index([deviceSyncRecordId])
  @@index([familyMemberId])
}

model WellnessGoal {
  id             String              @id @default(cuid())
  ownerUserId    String
  familyMemberId String?
  category       WellnessCategory
  unit           WellnessUnit
  targetValue    Decimal             @db.Decimal(12, 3)
  cadence        WellnessGoalCadence @default(DAILY)
  title          String
  status         WellnessGoalStatus  @default(ACTIVE)
  startOn        DateTime
  endOn          DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  owner User @relation("WellnessGoalOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)

  @@index([ownerUserId, status])
}

// ---------------------------------------------------------------------------
// Module G — health devices
// ---------------------------------------------------------------------------

/// An optional connection to a wearable or a health data source.
///
/// `integrationMode` is the honest answer to "does this actually work": the
/// platform ships with `NOT_CONFIGURED` for every provider except manual file
/// import, and a connector only appears once a real one is deployed and a real
/// credential exists. The UI reads this and labels the option accordingly, so a
/// person is never shown a "Connect with Fitbit" button backed by nothing.
model HealthDeviceConnection {
  id                   String                       @id @default(cuid())
  ownerUserId          String
  provider             HealthDeviceProvider
  integrationMode      HealthDeviceIntegrationMode  @default(NOT_CONFIGURED)
  status               HealthDeviceConnectionStatus @default(PENDING)
  /// A label for the external account, e.g. the masked address the vendor
  /// reported. Never a credential: no token or refresh secret is stored here.
  externalAccountLabel String?
  scopes               String[]
  /// Free-text note where the integration failed, safe to show to the owner.
  lastError            String?
  lastSyncedAt         DateTime?
  connectedAt          DateTime?
  revokedAt            DateTime?
  createdAt            DateTime                     @default(now())
  updatedAt            DateTime                     @updatedAt

  owner User                     @relation("DeviceConnectionOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)
  syncs HealthDeviceSyncRecord[]

  @@unique([ownerUserId, provider])
  @@index([ownerUserId, status])
}

/// One import run. Kept so an imported reading can always be traced back to the
/// sync that produced it, and so a failed sync is visible rather than silent.
model HealthDeviceSyncRecord {
  id                   String                 @id @default(cuid())
  connectionId         String
  status               HealthDeviceSyncStatus @default(STARTED)
  /// The window the vendor reported, which is not the same as the import time.
  windowStart          DateTime?
  windowEnd            DateTime?
  startedAt            DateTime               @default(now())
  finishedAt           DateTime?
  measurementsImported Int                    @default(0)
  measurementsSkipped  Int                    @default(0)
  errorCode            String?
  errorMessage         String?
  /// Which ORVEXA categories the run touched, for a readable summary.
  categories           WellnessCategory[]

  connection HealthDeviceConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@index([connectionId, startedAt])
  @@index([status, startedAt])
}

// ---------------------------------------------------------------------------
// Module H — additional services, wellness resources and education
// ---------------------------------------------------------------------------

/// A discoverable service: physiotherapy, home nursing, home healthcare, home
/// sample collection, mental wellness counselling.
///
/// `verificationStatus` is carried so an unverified listing is visibly a listing
/// and is never presented as a vetted provider.
model CareServiceListing {
  id                 String                  @id @default(cuid())
  category           CareServiceCategory
  title              String
  summary            String?
  description        String?
  deliveryMode       CareServiceDeliveryMode
  /// Coarse starting price entered by the partner, in paise. Null means "ask",
  /// never "free".
  priceFromPaise     Int?
  city               String?
  serviceAreas       String[]
  /// Name of the provider as it wishes to be listed.
  providerLabel      String
  /// Set when the provider is an ORVEXA partner record, so the listing and the
  /// partner's own console stay in step.
  partnerProfileId   String?
  languagesOffered   SupportedLanguage[]
  isActive           Boolean                 @default(true)
  verificationStatus VerificationState       @default(UNVERIFIED)
  /// Where the data came from. A seeded demonstration listing is labelled.
  isDemo             Boolean                 @default(false)
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt

  @@index([category, isActive])
  @@index([city, category])
}

/// A person's request for one of the listings above.
///
/// `@@unique([requesterUserId, idempotencyKey])` stops a double submit from
/// raising two requests, and the status only moves when the provider acts — a
/// request is never auto-completed.
model CareServiceRequest {
  id               String                   @id @default(cuid())
  requesterUserId  String
  familyMemberId   String?
  listingId        String
  status           CareServiceRequestStatus @default(REQUESTED)
  preferredAt      DateTime?
  addressLine      String?
  city             String?
  postalCode       String?
  contactPhone     String?
  notes            String?
  /// What the provider said, if it has responded.
  providerResponse String?
  scheduledFor     DateTime?
  idempotencyKey   String
  isDemo           Boolean                  @default(false)
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt

  requester User @relation("CareServiceRequester", fields: [requesterUserId], references: [id], onDelete: Cascade)

  @@unique([requesterUserId, idempotencyKey])
  @@index([requesterUserId, status, createdAt])
  @@index([listingId, status])
}

/// Mental wellness material, including crisis helplines.
///
/// `isCrisisResource` marks a resource that must always be shown, including in
/// an emergency, and that must never be hidden behind a paywall or a sign-in.
model MentalWellnessResource {
  id               String                     @id @default(cuid())
  kind             MentalWellnessResourceKind
  title            String
  summary          String
  bodyMarkdown     String?
  language         SupportedLanguage          @default(ENGLISH)
  /// For a helpline: the number as it should be dialled, and its hours.
  helplineNumber   String?
  helplineHours    String?
  externalUrl      String?
  isCrisisResource Boolean                    @default(false)
  /// Who wrote or reviewed it, so a clinical claim has an author.
  reviewedByLabel  String?
  publishedAt      DateTime?
  isActive         Boolean                    @default(true)
  createdAt        DateTime                   @default(now())
  updatedAt        DateTime                   @updatedAt

  @@index([kind, language, isActive])
  @@index([isCrisisResource, isActive])
}

/// Patient-facing health education.
model HealthEducationResource {
  id              String                    @id @default(cuid())
  category        EducationResourceCategory
  language        SupportedLanguage         @default(ENGLISH)
  title           String
  summary         String
  bodyMarkdown    String
  readingMinutes  Int?
  /// Attribution for the medical content. Required: ORVEXA does not publish
  /// unreviewed clinical text.
  reviewedByLabel String
  reviewedOn      DateTime?
  isActive        Boolean                   @default(true)
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt

  @@index([category, language, isActive])
}

// ---------------------------------------------------------------------------
// Module I — service feedback, grievance tracking and support
// ---------------------------------------------------------------------------

model ServiceFeedback {
  id             String                 @id @default(cuid())
  authorUserId   String
  subject        ServiceFeedbackSubject
  /// The id of whatever the feedback is about, e.g. a PharmacyOrder id.
  subjectRefId   String?
  /// 1 to 5. Null when the person wrote a comment without rating.
  rating         Int?
  comment        String?
  status         ServiceFeedbackStatus  @default(SUBMITTED)
  acknowledgedAt DateTime?
  resolvedAt     DateTime?
  resolutionNote String?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  author User @relation("ServiceFeedbackAuthor", fields: [authorUserId], references: [id], onDelete: Cascade)

  @@index([authorUserId, createdAt])
  @@index([subject, status])
}

/// A grievance or a support request raised by a person.
///
/// Named `SupportTicket` rather than reusing the hospital `Complaint` model,
/// because a hospital complaint is raised *about* a hospital and is worked by
/// that hospital's staff, whereas this is the platform's own support queue and
/// is visible only to the person and platform staff.
model SupportTicket {
  id              String                @id @default(cuid())
  raisedByUserId  String
  reference       String                @unique
  category        SupportTicketCategory
  severity        SupportTicketSeverity @default(NORMAL)
  status          SupportTicketStatus   @default(OPEN)
  subject         String
  description     String
  /// Free text, because the person handling it may not be an ORVEXA user.
  assignedToLabel String?
  resolutionNote  String?
  resolvedAt      DateTime?
  closedAt        DateTime?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  raisedBy User                   @relation("SupportTicketRaisedBy", fields: [raisedByUserId], references: [id], onDelete: Cascade)
  messages SupportTicketMessage[]

  @@index([raisedByUserId, status, createdAt])
  @@index([status, severity, createdAt])
}

model SupportTicketMessage {
  id           String   @id @default(cuid())
  ticketId     String
  authorUserId String?
  authorLabel  String?
  body         String
  /// An internal note is visible to platform staff only and never to the person.
  isInternal   Boolean  @default(false)
  createdAt    DateTime @default(now())

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author User?         @relation("SupportTicketMessageAuthor", fields: [authorUserId], references: [id], onDelete: SetNull)

  @@index([ticketId, createdAt])
}

// ---------------------------------------------------------------------------
// Phase 11 — platform administration, configuration and operational controls.
//
// Everything below exists so the platform can be *operated* without anyone
// editing code: what is switched on, where it is switched on, how long data is
// kept, what an alert means, and who asked to be forgotten.
//
// Three rules shape these tables:
//
// 1. Configuration is a row with an author, not a constant. "Which regions are
//    supported", "is online pharmacy live" and "how long is an audit row kept"
//    are all editable by a named administrator, and the change is auditable.
//
// 2. A flag defaults to OFF and a rollout defaults to 0. The safe state is the
//    default state, so a table that has just been created cannot switch on a
//    half-built feature for everybody at once.
//
// 3. Retention and deletion are records, not cron trivia. A purge writes what it
//    purged and when; a deletion request carries a scheduled date, an actor and
//    an outcome, because "we deleted their account" is a claim the platform may
//    have to evidence.
// ---------------------------------------------------------------------------

enum PlatformSettingCategory {
  SERVICE_CATALOGUE
  REGIONS
  NOTIFICATIONS
  SECURITY
  OPERATIONS
}

/// What a person does inside the platform's own operations.
///
/// This is deliberately *not* a value of the platform `Role` enum. A platform
/// role decides which console an account lands in and is visible in the product;
/// a platform staff role is an operational grant, held as a row, that can be
/// given and taken away without touching the account's identity. A reviewer who
/// only works the hospital verification queue therefore holds no administrative
/// role at all, which is the point: the smallest privilege that does the job.
enum PlatformStaffRole {
  PLATFORM_ADMIN
  VERIFICATION_HOSPITAL
  VERIFICATION_DOCTOR
  VERIFICATION_PHARMACY
  VERIFICATION_LABORATORY
  VERIFICATION_AMBULANCE
  VERIFICATION_INSURER
  SUPPORT_AGENT
  EMERGENCY_OPERATOR
  SECURITY_ANALYST
}

enum PlatformStaffStatus {
  INVITED
  ACTIVE
  REVOKED
}

/// A platform staff grant. Mirrors `HospitalMember`, one level up.
///
/// The permissions a grant confers are derived from its role in code
/// (`PLATFORM_STAFF_ROLE_PERMISSIONS`), never stored, so the set can never drift
/// from the screen that is guarded by it. Revoking sets `status` to `REVOKED`
/// and stamps `revokedAt`; the row is kept so "who could see this queue in March"
/// stays answerable.
model PlatformStaffMember {
  id          String              @id @default(cuid())
  userId      String
  role        PlatformStaffRole
  status      PlatformStaffStatus @default(ACTIVE)
  grantedById String?
  grantedAt   DateTime            @default(now())
  revokedAt   DateTime?
  reason      String?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  user      User  @relation("PlatformStaffMemberUser", fields: [userId], references: [id], onDelete: Cascade)
  grantedBy User? @relation("PlatformStaffGrantedBy", fields: [grantedById], references: [id], onDelete: SetNull)

  @@unique([userId, role])
  @@index([role, status])
}

/// A single named piece of platform configuration.
///
/// `value` is JSON so a setting can be a boolean, a number, a string or a small
/// object without a migration per change. The shape is validated by the service
/// that writes it (`src/lib/admin/configuration.ts`), never by this table, and
/// every write records `updatedById`.
model PlatformSetting {
  id          String                 @id @default(cuid())
  key         String                 @unique
  category    PlatformSettingCategory
  label       String
  description String?
  value       Json
  updatedById String?
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt

  updatedBy User? @relation("PlatformSettingUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([category])
}

/// A runtime feature switch.
///
/// `enabled` is the master switch and `rolloutPercent` is the gradual one: a
/// flag is only served to a subject when `enabled` is true *and* the subject
/// falls inside the rollout bucket. `environments` names the deployments the
/// flag applies to, so a flag can be live in staging while dark in production.
model FeatureFlag {
  id             String   @id @default(cuid())
  key            String   @unique
  description    String
  enabled        Boolean  @default(false)
  rolloutPercent Int      @default(0)
  environments   String[] @default(["development"])
  updatedById    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  updatedBy User? @relation("FeatureFlagUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([enabled])
}

enum IntegrationAlertKind {
  SECURITY
  INTEGRATION
}

enum IntegrationAlertSeverity {
  INFO
  WARNING
  CRITICAL
}

enum IntegrationAlertStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
}

/// An alert raised by the platform about itself: a rejected provider webhook, a
/// dispatch that could not be delivered, a burst of cross-tenant access attempts.
///
/// Alerts are deduplicated on `fingerprint` while they are `OPEN`, so a failing
/// integration that fails a thousand times produces one row with
/// `occurrences = 1000` rather than a thousand rows nobody reads. Resolving the
/// row frees the fingerprint, so a genuine recurrence opens a fresh alert.
model IntegrationAlert {
  id               String                   @id @default(cuid())
  kind             IntegrationAlertKind
  severity         IntegrationAlertSeverity @default(WARNING)
  status           IntegrationAlertStatus   @default(OPEN)
  /// Stable identifier of the condition, e.g. "payment_webhook:signature_invalid".
  fingerprint      String
  source           String
  title            String
  detail           String?
  occurrences      Int                      @default(1)
  firstSeenAt      DateTime                 @default(now())
  lastSeenAt       DateTime                 @default(now())
  acknowledgedById String?
  acknowledgedAt   DateTime?
  resolvedAt       DateTime?
  metadata         Json?

  acknowledgedBy User? @relation("IntegrationAlertAcknowledgedBy", fields: [acknowledgedById], references: [id], onDelete: SetNull)

  @@index([status, severity, lastSeenAt])
  @@index([fingerprint, status])
}

/// How long each class of data is kept, and a record of the last purge.
///
/// The audit log's 24-month window used to be a constant
/// (`AUDIT_RETENTION_MONTHS`); it is a row here so the platform can show what it
/// keeps and prove when it last pruned, without a deployment.
model RetentionPolicy {
  id              String    @id @default(cuid())
  /// Stable data-class key, e.g. "audit_event" or "expired_session".
  dataClass       String    @unique
  label           String
  retentionDays   Int
  description     String?
  lastPurgedAt    DateTime?
  lastPurgedCount Int?
  updatedById     String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  updatedBy User? @relation("RetentionPolicyUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
}

enum AccountDeletionStatus {
  REQUESTED
  CANCELLED
  COMPLETED
  BLOCKED
}

/// A person's request to be forgotten.
///
/// The platform does not delete immediately. Money movements, clinical records
/// and claims carry statutory retention, so a request is recorded, given a
/// `scheduledFor` date, and may be resolved as `BLOCKED` with a reason when a
/// retention obligation applies. `COMPLETED` is only written once the
/// anonymisation actually ran.
model AccountDeletionRequest {
  id                 String                 @id @default(cuid())
  userId             String
  status             AccountDeletionStatus   @default(REQUESTED)
  reason             String?
  requestedAt        DateTime               @default(now())
  scheduledFor       DateTime
  processedAt        DateTime?
  blockedReason      String?
  processedById      String?
  /// When the request was refused because of a retention obligation, the date
  /// the obligation lapses so the request can be re-raised.
  retentionHoldUntil DateTime?
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  user        User  @relation("AccountDeletionRequester", fields: [userId], references: [id], onDelete: Cascade)
  processedBy User? @relation("AccountDeletionProcessor", fields: [processedById], references: [id], onDelete: SetNull)

  @@index([status, scheduledFor])
  @@index([userId])
}

enum ReportExportStatus {
  QUEUED
  READY
  FAILED
  EXPIRED
}

/// An authorized report export.
///
/// Every export is a row before it is a file: who asked, what range, whether the
/// result contains personal data, how many rows it produced and when it expires.
/// `containsPersonalData` drives the privacy control — an export that carries
/// personal data is limited to the analyst role and is deleted when it expires.
model ReportExport {
  id                  String             @id @default(cuid())
  requestedById       String
  requestedByLabel    String
  reportKey           String
  format              String             @default("csv")
  filters             Json?
  containsPersonalData Boolean           @default(false)
  status              ReportExportStatus @default(QUEUED)
  rowCount            Int?
  /// Storage key for the generated file. Null until the export is READY.
  fileKey             String?
  checksum            String?
  errorMessage        String?
  createdAt           DateTime           @default(now())
  completedAt         DateTime?
  expiresAt           DateTime?

  requestedBy User @relation("ReportExportRequestedBy", fields: [requestedById], references: [id], onDelete: Cascade)

  @@index([requestedById, createdAt])
  @@index([status, expiresAt])
}

/// Platform-wide operational counters, sampled by the maintenance job.
///
/// A metric is a *measurement of a window*, so the row carries the window it
/// describes rather than a rolling number that cannot be interpreted later.
/// Nothing here is derived from an assumption: a metric that was not collected
/// is absent, and the analytics view reports it as missing rather than as zero.
model OperationalMetric {
  id         String   @id @default(cuid())
  metricKey  String
  windowFrom DateTime
  windowTo   DateTime
  value      Float
  /// Set when the value is known to be partial (e.g. a provider was down for
  /// part of the window) so it is never presented as a complete figure.
  isPartial  Boolean  @default(false)
  metadata   Json?
  recordedAt DateTime @default(now())

  @@unique([metricKey, windowFrom, windowTo])
  @@index([metricKey, recordedAt])
}

enum AbuseReportStatus {
  OPEN
  UNDER_REVIEW
  ACTIONED
  DISMISSED
  ESCALATED
}

enum AbuseReportCategory {
  HARASSMENT
  FRAUD
  IMPERSONATION
  UNSAFE_PROVIDER
  SPAM
  INAPPROPRIATE_CONTENT
  PRIVACY_VIOLATION
  OTHER
}

/// A report of abusive behaviour by an account, a partner or a listing.
///
/// Distinct from a support ticket. A ticket is a request for help and ends when
/// the person is helped; an abuse report is an allegation against somebody and
/// ends with an enforcement decision that a named operator is accountable for.
/// Keeping them apart means the support queue can be worked by support agents
/// while the abuse queue stays behind `platform.grievance_manage`.
///
/// The subject is recorded as `kind` + `id` rather than a foreign key, so a
/// report can name a partner, a user or a listing without a mismatched cascade,
/// and so removing the subject never erases the complaint about it.
model AbuseReport {
  id              String              @id @default(cuid())
  reference       String              @unique
  reporterUserId  String?
  reporterLabel   String?
  subjectKind     String
  subjectId       String?
  subjectLabel    String?
  category        AbuseReportCategory @default(OTHER)
  severity        ComplaintSeverity   @default(LOW)
  summary         String
  detail          String?
  evidenceKeys    String[]            @default([])
  status          AbuseReportStatus   @default(OPEN)
  assignedToLabel String?
  resolutionNotes String?
  decidedById     String?
  decidedAt       DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  reporter  User? @relation("AbuseReportReporter", fields: [reporterUserId], references: [id], onDelete: SetNull)
  decidedBy User? @relation("AbuseReportDecidedBy", fields: [decidedById], references: [id], onDelete: SetNull)

  @@index([status, severity, createdAt])
  @@index([subjectKind, subjectId])
}
