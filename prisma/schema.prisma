// ---------------------------------------------------------------------------
// Module 1 — patient registration and medical record lookup
// ---------------------------------------------------------------------------

/// A patient as registered at *one* hospital.
///
/// This is deliberately not `PatientProfile`. A platform patient profile
/// belongs to a person's own ORVEXA account; a hospital registration is the
/// hospital's record of someone who walked in, who may have no ORVEXA account
/// at all. `userId` links the two when the person does have an account, and the
/// medical record number is assigned by the hospital and unique inside it.
///
/// Registering a patient is not treating one: the hospital is expected to hold
/// the patient's `HOSPITAL_TREATMENT_CONSENT` before clinical facts are
/// recorded, and the writers below refuse to open a clinical record without it.
model HospitalPatient {
  id                    String      @id @default(cuid())
  hospitalId            String
  /// Medical record number. Unique inside the hospital, assigned by hospital staff.
  mrn                   String
  /// The person's ORVEXA account, when they have one. Null for a walk-in.
  userId                String?
  fullName              String
  dateOfBirth           DateTime?
  /// Used only when the exact date of birth is unknown, which is common in
  /// emergency intake. Never used to overwrite a known date of birth.
  approximateAgeYears   Int?
  gender                Gender?
  bloodGroup            BloodGroup?
  phone                 String?
  email                 String?
  addressLine1          String?
  city                  String?
  state                 String?
  postalCode            String?
  /// Last four digits only. A hospital does not need the platform to hold a full
  /// national identifier to find a patient.
  nationalIdLast4       String?
  emergencyContactName  String?
  emergencyContactPhone String?
  allergies             String[]
  chronicConditions     String[]
  registrationSource    String?
  registeredById        String?
  notes                 String?
  /// Marks a row created by the synthetic seed script for development demos.
  isDemo                Boolean     @default(false)
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt
  deletedAt             DateTime?

  hospital Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)

  @@unique([hospitalId, mrn])
  @@index([hospitalId, fullName])
  @@index([hospitalId, phone])
  @@index([userId])
  @@index([hospitalId, createdAt])
}

// ---------------------------------------------------------------------------
// Module 2 — OPD registration, queues, tokens and the waiting room
// ---------------------------------------------------------------------------

model OpdDepartment {
  id          String   @id @default(cuid())
  hospitalId  String
  name        String
  code        String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  hospital Hospital   @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  visits   OpdVisit[]

  @@unique([hospitalId, code])
  @@index([hospitalId, isActive])
}

/// One OPD encounter: a registration, a token and a place in a department queue.
///
/// The token number is allocated inside the transaction that creates the visit,
/// so two receptionists registering at the same moment cannot be handed the same
/// token. Queue position is never stored: it is derived from the live queue when
/// the waiting room is read, so it cannot go stale.
model OpdVisit {
  id                   String         @id @default(cuid())
  hospitalId           String
  patientId            String
  departmentId         String
  doctorProfileId      String?
  appointmentId        String?
  /// Token issued by this hospital. Unique per hospital per day; allocated by the service.
  tokenNumber          Int
  priority             OpdPriority    @default(ROUTINE)
  status               OpdVisitStatus @default(WAITING)
  chiefComplaint       String?
  registeredById       String?
  registeredByName     String?
  consultationFeePaise Int?
  registeredAt         DateTime       @default(now())
  calledAt             DateTime?
  startedAt            DateTime?
  completedAt          DateTime?
  cancelledAt          DateTime?
  cancellationReason   String?
  notes                String?
  isDemo               Boolean        @default(false)
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  hospital   Hospital        @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  department OpdDepartment   @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  events     OpdVisitEvent[]

  @@index([hospitalId, status, priority, registeredAt])
  @@index([hospitalId, departmentId, status])
  @@index([patientId])
}

model OpdVisitEvent {
  id          String             @id @default(cuid())
  visitId     String
  type        OpdVisitEventType
  fromStatus  OpdVisitStatus?
  toStatus    OpdVisitStatus?
  actorUserId String?
  actorRole   HospitalStaffRole?
  actorLabel  String?
  note        String?
  createdAt   DateTime           @default(now())

  visit OpdVisit @relation(fields: [visitId], references: [id], onDelete: Cascade)

  @@index([visitId, createdAt])
}

// ---------------------------------------------------------------------------
// Module 3 — IPD admission, bed allocation, wards, transfers and discharge
// ---------------------------------------------------------------------------

model Ward {
  id         String   @id @default(cuid())
  hospitalId String
  name       String
  code       String
  wardType   WardType @default(GENERAL)
  floor      String?
  isActive   Boolean  @default(true)
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  hospital Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  beds     Bed[]

  @@unique([hospitalId, code])
  @@index([hospitalId, isActive])
}

/// A physical bed. `status` is what hospital staff have most recently entered —
/// it is an operational record, not a live sensor reading, and the dashboard
/// labels it as such.
model Bed {
  id                String    @id @default(cuid())
  hospitalId        String
  wardId            String
  code              String
  status            BedStatus @default(AVAILABLE)
  isActive          Boolean   @default(true)
  notes             String?
  statusChangedAt   DateTime  @default(now())
  statusChangedById String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  hospital   Hospital    @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  ward       Ward        @relation(fields: [wardId], references: [id], onDelete: Cascade)
  admissions Admission[]

  @@unique([wardId, code])
  @@index([hospitalId, status])
  @@index([hospitalId, wardId, status])
}

/// An inpatient stay. At most one Active admission may hold a given bed at a
/// time; that rule is enforced by a partial unique index created in the
/// migration and by the conditional update inside `assignBed`.
model Admission {
  id                       String          @id @default(cuid())
  hospitalId               String
  patientId                String
  /// Unique per hospital, generated by the service.
  admissionNumber          String
  admissionType            AdmissionType   @default(ELECTIVE)
  status                   AdmissionStatus @default(ADMITTED)
  wardId                   String?
  bedId                    String?
  admittingDoctorProfileId String?
  attendingMemberId        String?
  reasonForAdmission       String?
  primaryDiagnosis         String?
  admittedAt               DateTime        @default(now())
  admittedById             String?
  dischargeRequestedAt     DateTime?
  dischargeRequestedById   String?
  dischargedAt             DateTime?
  dischargedById           String?
  dischargeType            String?
  dischargeSummary         String?
  followUpInstructions     String?
  cancelledAt              DateTime?
  cancellationReason       String?
  isDemo                   Boolean         @default(false)
  createdAt                DateTime        @default(now())
  updatedAt                DateTime        @updatedAt

  hospital  Hospital      @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  bed       Bed?          @relation(fields: [bedId], references: [id], onDelete: SetNull)
  transfers BedTransfer[]

  @@unique([hospitalId, admissionNumber])
  @@index([hospitalId, status, admittedAt])
  @@index([patientId])
  @@index([bedId])
}

model BedTransfer {
  id                 String            @id @default(cuid())
  hospitalId         String
  admissionId        String
  fromBedId          String?
  toBedId            String
  fromWardId         String?
  toWardId           String
  reason             String?
  status             BedTransferStatus @default(REQUESTED)
  requestedById      String?
  requestedAt        DateTime          @default(now())
  approvedById       String?
  approvedAt         DateTime?
  completedAt        DateTime?
  cancelledAt        DateTime?
  cancellationReason String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  hospital  Hospital  @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  admission Admission @relation(fields: [admissionId], references: [id], onDelete: Cascade)

  @@index([hospitalId, status])
  @@index([admissionId, createdAt])
}

// ---------------------------------------------------------------------------
// Module 4 — staff roles, shifts and nursing assignments
// ---------------------------------------------------------------------------

model HospitalShift {
  id           String      @id @default(cuid())
  hospitalId   String
  memberId     String
  wardId       String?
  departmentId String?
  shiftType    ShiftType   @default(GENERAL)
  status       ShiftStatus @default(SCHEDULED)
  startsAt     DateTime
  endsAt       DateTime
  assignedById String?
  notes        String?
  isDemo       Boolean     @default(false)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  hospital Hospital       @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  member   HospitalMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([hospitalId, startsAt])
  @@index([memberId, startsAt])
  @@index([hospitalId, wardId, startsAt])
}

/// The nurse(s) looking after one inpatient stay. `isActive` marks the current
/// assignment; ending one never deletes the history.
model NursingAssignment {
  id           String    @id @default(cuid())
  hospitalId   String
  admissionId  String
  memberId     String
  shiftId      String?
  assignedById String?
  startsAt     DateTime  @default(now())
  endsAt       DateTime?
  isActive     Boolean   @default(true)
  notes        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  hospital Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)

  @@index([hospitalId, isActive])
  @@index([admissionId, isActive])
  @@index([memberId, startsAt])
}

// ---------------------------------------------------------------------------
// Module 5 — electronic medical records, notes, diagnoses and prescriptions
// ---------------------------------------------------------------------------

/// A single entry in a patient's hospital record. Entries are append-only: a
/// correction adds an amendment row referencing the original rather than
/// rewriting history.
model MedicalRecordEntry {
  id              String                 @id @default(cuid())
  hospitalId      String
  patientId       String
  opdVisitId      String?
  admissionId     String?
  entryType       MedicalRecordEntryType
  title           String?
  body            String?
  structured      Json?
  /// The member of staff who wrote the entry. Never null: an unattributed
  /// clinical entry would be worse than no entry at all.
  recordedById    String
  recordedByName  String?
  recordedByRole  HospitalStaffRole?
  recordedAt      DateTime               @default(now())
  amendedFromId   String?
  amendmentReason String?
  isDemo          Boolean                @default(false)
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  hospital Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)

  @@index([hospitalId, patientId, recordedAt])
  @@index([hospitalId, entryType, recordedAt])
  @@index([admissionId])
}

model Diagnosis {
  id              String             @id @default(cuid())
  hospitalId      String
  patientId       String
  opdVisitId      String?
  admissionId     String?
  /// ICD-10 code when the hospital's clinicians record one. Free text otherwise.
  code            String?
  description     String
  diagnosisType   DiagnosisType      @default(PROVISIONAL)
  certainty       DiagnosisCertainty @default(SUSPECTED)
  diagnosedById   String
  diagnosedByName String?
  diagnosedAt     DateTime           @default(now())
  isDemo          Boolean            @default(false)
  createdAt       DateTime           @default(now())

  hospital Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)

  @@index([hospitalId, patientId])
  @@index([hospitalId, code])
}

model VitalSignsObservation {
  id              String             @id @default(cuid())
  hospitalId      String
  patientId       String
  admissionId     String?
  opdVisitId      String?
  temperatureC    Float?
  pulseBpm        Int?
  respiratoryRate Int?
  systolicBp      Int?
  diastolicBp     Int?
  spo2Percent     Int?
  painScore       Int?
  weightKg        Float?
  heightCm        Float?
  notes           String?
  recordedById    String
  recordedByName  String?
  recordedByRole  HospitalStaffRole?
  recordedAt      DateTime           @default(now())
  isDemo          Boolean            @default(false)
  createdAt       DateTime           @default(now())

  hospital Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)

  @@index([hospitalId, patientId, recordedAt])
  @@index([admissionId])
}

/// A prescription issued inside the hospital. Distinct from the platform's
/// `Prescription`, which belongs to a patient's own account and travels to a
/// pharmacy partner. This one is the hospital's own record and can be used for
/// an inpatient who has no ORVEXA account.
///
/// Only a member of staff whose role carries `hospital.prescribe` may issue one,
/// and the prescriber's id and registration are stored on the row.
model HospitalPrescription {
  id                     String                     @id @default(cuid())
  hospitalId             String
  patientId              String
  reference              String
  opdVisitId             String?
  admissionId            String?
  status                 HospitalPrescriptionStatus @default(DRAFT)
  prescriberUserId       String
  prescriberName         String?
  prescriberRegistration String?
  issuedAt               DateTime?
  cancelledAt            DateTime?
  cancellationReason     String?
  notes                  String?
  isDemo                 Boolean                    @default(false)
  createdAt              DateTime                   @default(now())
  updatedAt              DateTime                   @updatedAt

  hospital Hospital                   @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  items    HospitalPrescriptionItem[]

  @@unique([hospitalId, reference])
  @@index([hospitalId, patientId, issuedAt])
  @@index([hospitalId, status])
}

model HospitalPrescriptionItem {
  id             String   @id @default(cuid())
  prescriptionId String
  medicineName   String
  dosageForm     String?
  strength       String?
  route          String?
  frequency      String?
  durationDays   Int?
  quantity       String?
  instructions   String?
  isControlled   Boolean  @default(false)
  createdAt      DateTime @default(now())

  prescription HospitalPrescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)

  @@index([prescriptionId])
}

// ---------------------------------------------------------------------------
// Module 6 — laboratory orders, report workflow and imaging referrals
// ---------------------------------------------------------------------------

model HospitalLabOrder {
  id                 String                   @id @default(cuid())
  hospitalId         String
  patientId          String
  reference          String
  opdVisitId         String?
  admissionId        String?
  priority           HospitalLabOrderPriority @default(ROUTINE)
  status             HospitalLabOrderStatus   @default(ORDERED)
  clinicalNotes      String?
  orderedById        String
  orderedByName      String?
  orderedAt          DateTime                 @default(now())
  collectedAt        DateTime?
  resultedAt         DateTime?
  cancelledAt        DateTime?
  cancellationReason String?
  isDemo             Boolean                  @default(false)
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt

  hospital Hospital               @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  items    HospitalLabOrderItem[]

  @@unique([hospitalId, reference])
  @@index([hospitalId, status, orderedAt])
  @@index([patientId])
}

model HospitalLabOrderItem {
  id        String                 @id @default(cuid())
  orderId   String
  testCode  String?
  testName  String
  specimen  String?
  status    HospitalLabOrderStatus @default(ORDERED)
  createdAt DateTime               @default(now())
  updatedAt DateTime               @updatedAt

  order   HospitalLabOrder    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  results HospitalLabResult[]

  @@index([orderId])
}

/// One analyte on one ordered test. A result carries the laboratory scientist
/// who produced it and, separately, the person who verified it. A result that
/// has not been verified is reported as unverified everywhere it is shown.
model HospitalLabResult {
  id             String        @id @default(cuid())
  hospitalId     String
  orderItemId    String
  analyteName    String
  value          String
  unit           String?
  referenceRange String?
  flag           LabResultFlag @default(UNKNOWN)
  resultedById   String
  resultedByName String?
  resultedAt     DateTime      @default(now())
  verifiedById   String?
  verifiedByName String?
  verifiedAt     DateTime?
  isDemo         Boolean       @default(false)
  createdAt      DateTime      @default(now())

  hospital Hospital             @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  item     HospitalLabOrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  @@index([hospitalId, orderItemId])
}

model ImagingReferral {
  id                 String                   @id @default(cuid())
  hospitalId         String
  patientId          String
  reference          String
  modality           ImagingModality
  bodyPart           String
  clinicalIndication String?
  priority           HospitalLabOrderPriority @default(ROUTINE)
  status             ImagingReferralStatus    @default(REFERRED)
  referredById       String
  referredByName     String?
  referredAt         DateTime                 @default(now())
  scheduledAt        DateTime?
  performedAt        DateTime?
  reportedAt         DateTime?
  /// Written by the reporting radiologist, never generated by the platform.
  reportText         String?
  impression         String?
  reportedById       String?
  reportedByName     String?
  isDemo             Boolean                  @default(false)
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt

  hospital Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)

  @@unique([hospitalId, reference])
  @@index([hospitalId, status, referredAt])
  @@index([patientId])
}

// ---------------------------------------------------------------------------
// Module 7 — pharmacy inventory, stock movements, expiry alerts, dispensing
// ---------------------------------------------------------------------------

model HospitalPharmacyUnit {
  id         String   @id @default(cuid())
  hospitalId String
  name       String
  code       String
  location   String?
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  hospital   Hospital            @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  stockItems HospitalStockItem[]
  dispenses  HospitalDispense[]

  @@unique([hospitalId, code])
  @@index([hospitalId, isActive])
}

/// One stock line: a medicine batch, a consumable or a piece of equipment held
/// at a location. Quantity is a running balance; every change also writes a
/// `HospitalStockMovement`, so the balance can always be reconstructed.
model HospitalStockItem {
  id                String                @id @default(cuid())
  hospitalId        String
  pharmacyUnitId    String?
  supplierId        String?
  itemKind          HospitalStockItemKind @default(MEDICINE)
  /// SKU chosen by the hospital, unique inside it.
  code              String
  name              String
  description       String?
  unit              String                @default("unit")
  dosageForm        String?
  strengthLabel     String?
  batchNumber       String?
  expiryDate        DateTime?
  quantityOnHand    Int                   @default(0)
  reorderLevel      Int                   @default(0)
  unitCostPaise     Int?
  sellingPricePaise Int?
  taxRateBp         Int                   @default(0)
  location          String?
  isActive          Boolean               @default(true)
  isDemo            Boolean               @default(false)
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  hospital      Hospital                @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  pharmacyUnit  HospitalPharmacyUnit?   @relation(fields: [pharmacyUnitId], references: [id], onDelete: SetNull)
  supplier      HospitalSupplier?       @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  movements     HospitalStockMovement[]
  alerts        HospitalStockAlert[]
  dispenseItems HospitalDispenseItem[]

  @@unique([hospitalId, code])
  @@index([hospitalId, itemKind, isActive])
  @@index([hospitalId, expiryDate])
}

model HospitalStockMovement {
  id              String            @id @default(cuid())
  hospitalId      String
  stockItemId     String
  type            StockMovementType
  /// Signed: positive adds stock, negative removes it.
  quantityDelta   Int
  balanceAfter    Int
  reason          String?
  referenceType   String?
  referenceId     String?
  performedById   String
  performedByName String?
  occurredAt      DateTime          @default(now())
  isDemo          Boolean           @default(false)

  hospital  Hospital          @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  stockItem HospitalStockItem @relation(fields: [stockItemId], references: [id], onDelete: Cascade)

  @@index([hospitalId, stockItemId, occurredAt])
  @@index([hospitalId, type, occurredAt])
}

model HospitalStockAlert {
  id               String                   @id @default(cuid())
  hospitalId       String
  stockItemId      String
  type             HospitalStockAlertType
  status           HospitalStockAlertStatus @default(OPEN)
  detail           String?
  threshold        Int?
  detectedAt       DateTime                 @default(now())
  acknowledgedById String?
  acknowledgedAt   DateTime?
  resolvedAt       DateTime?
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt

  hospital  Hospital          @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  stockItem HospitalStockItem @relation(fields: [stockItemId], references: [id], onDelete: Cascade)

  @@index([hospitalId, status, type])
  @@index([stockItemId, status])
}

/// A dispensing record. `@@unique([hospitalId, idempotencyKey])` makes a double
/// tap resolve to the same dispense instead of decrementing stock twice, and
/// stock is only ever decremented inside the transaction that writes the items.
model HospitalDispense {
  id              String                 @id @default(cuid())
  hospitalId      String
  pharmacyUnitId  String?
  patientId       String
  admissionId     String?
  prescriptionId  String?
  reference       String
  status          HospitalDispenseStatus @default(PENDING)
  idempotencyKey  String
  dispensedById   String?
  dispensedByName String?
  dispensedAt     DateTime?
  notes           String?
  isDemo          Boolean                @default(false)
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  hospital     Hospital               @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  pharmacyUnit HospitalPharmacyUnit?  @relation(fields: [pharmacyUnitId], references: [id], onDelete: SetNull)
  items        HospitalDispenseItem[]

  @@unique([hospitalId, reference])
  @@unique([hospitalId, idempotencyKey])
  @@index([hospitalId, status, createdAt])
  @@index([patientId])
}

model HospitalDispenseItem {
  id             String    @id @default(cuid())
  dispenseId     String
  stockItemId    String
  nameSnapshot   String
  batchNumber    String?
  expiryDate     DateTime?
  quantity       Int
  unitPricePaise Int?
  createdAt      DateTime  @default(now())

  dispense  HospitalDispense  @relation(fields: [dispenseId], references: [id], onDelete: Cascade)
  stockItem HospitalStockItem @relation(fields: [stockItemId], references: [id], onDelete: Restrict)

  @@unique([dispenseId, stockItemId])
  @@index([stockItemId])
}

