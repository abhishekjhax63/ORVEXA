# ORVEXA environment template.
#
# Copy to `.env.local` and fill in real values. Never commit `.env.local`.
# Variables are read when their features are used. Missing required values fail
# with an actionable setup message; optional integrations should report when
# unavailable rather than silently falling back to an insecure default.

# ---------------------------------------------------------------------------
# Core (required)
# ---------------------------------------------------------------------------

# PostgreSQL connection string (Supabase pooled connection is fine).
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE"

# Signing key for session tokens, OTP codes and location-share links.
# Generate with: openssl rand -base64 48
AUTH_SECRET=""

# Shared secret that guards internal maintenance endpoints.
CRON_SECRET=""

# Absolute public origin. Used for verification links and location-share links.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Optional Supabase browser-client credentials. The anon key is public by
# design; access must be controlled by Supabase Auth and row-level security.
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# ---------------------------------------------------------------------------
# Google sign-in (optional — leave blank and the button renders disabled with
# the exact missing configuration named, never as a dead control)
# ---------------------------------------------------------------------------
#
# Setup, in the Google Cloud Console:
#   1. APIs & Services -> OAuth consent screen: choose External, fill in the app
#      name, support email and developer contact, then publish (or add yourself
#      as a test user while it is in "Testing").
#   2. APIs & Services -> Credentials -> Create credentials -> OAuth client ID
#      -> Application type: Web application.
#   3. Authorised JavaScript origins:
#        http://localhost:3000
#        https://YOUR_PRODUCTION_ORIGIN
#   4. Authorised redirect URIs — this must match the app's callback exactly:
#        http://localhost:3000/api/auth/google/callback
#        https://YOUR_PRODUCTION_ORIGIN/api/auth/google/callback
#   5. Copy the client ID and client secret below. The secret stays server-side;
#      it is never sent to the browser and never written to a log.
#
# The callback path is `${NEXT_PUBLIC_SITE_URL}/api/auth/google/callback`. If you
# serve the app from a different origin than NEXT_PUBLIC_SITE_URL, set
# GOOGLE_OAUTH_REDIRECT_URI explicitly and register that value in step 4 instead.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# GOOGLE_OAUTH_REDIRECT_URI="https://YOUR_PRODUCTION_ORIGIN/api/auth/google/callback"

# ---------------------------------------------------------------------------
# Email and SMS (optional — leave blank and the UI reports the channel as
# unavailable instead of claiming a message was delivered)
# ---------------------------------------------------------------------------

EMAIL_PROVIDER_API_KEY=""
EMAIL_PROVIDER_FROM="ORVEXA <YOUR_SENDER_EMAIL>"

SMS_PROVIDER_API_KEY=""
SMS_PROVIDER_SENDER_ID=""

# ---------------------------------------------------------------------------
# Maps — Phase 4
# ---------------------------------------------------------------------------
# Browser-safe values. Mapbox public tokens (pk.*) and Geoapify tile keys are
# designed to be embedded in a page; restrict them by URL in the provider
# dashboard.
#
# NEXT_PUBLIC_MAPS_PROVIDER: "mapbox" | "geoapify" | "google" | unset
# The interactive map supports Mapbox and Geoapify. Google is supported for
# server-side geocoding/routing but its browser map is not implemented.
NEXT_PUBLIC_MAPS_PROVIDER=""
NEXT_PUBLIC_MAPS_ACCESS_TOKEN=""
# Mapbox style URL, e.g. mapbox://styles/mapbox/streets-v12
NEXT_PUBLIC_MAPS_STYLE_URL=""
# "lng,lat" — the same order both providers use in URLs.
NEXT_PUBLIC_MAPS_DEFAULT_CENTER="77.5946,12.9716"
NEXT_PUBLIC_MAPS_DEFAULT_ZOOM="11"

# Server-only credentials used for geocoding and directions. These are proxied
# through /api/geo/* so the secret never reaches the browser.
# MAPS_PROVIDER should match NEXT_PUBLIC_MAPS_PROVIDER for server lookups.
# Geoapify may also read GEOAPIFY_API_KEY when MAPS_SERVER_TOKEN is blank.
MAPS_PROVIDER=""
MAPS_SERVER_TOKEN=""
GEOAPIFY_API_KEY=""

# ---------------------------------------------------------------------------
# Emergency — Phase 4
# ---------------------------------------------------------------------------
# NEXT_PUBLIC_EMERGENCY_DISPATCH_MODE:
#   "disabled"    — no outbound request may be created at all
#   "manual_call" — incidents are recorded, every call is placed by a human
#   "live"        — automated fan-out is attempted where a channel is configured
NEXT_PUBLIC_EMERGENCY_DISPATCH_MODE="manual_call"

# Region drives the dial targets shown in the UI. Supports "IN".
NEXT_PUBLIC_EMERGENCY_REGION="IN"

# Set to true only after the release owner has confirmed the numbers below for
# the target region. While false the UI labels the numbers as needing local
# confirmation instead of presenting them as verified.
NEXT_PUBLIC_EMERGENCY_NUMBER_VERIFIED="false"

# India dial targets. Defaults are the published national numbers; override only
# with verified regional numbers.
NEXT_PUBLIC_EMERGENCY_NUMBER=""
NEXT_PUBLIC_EMERGENCY_AMBULANCE_NUMBER=""
NEXT_PUBLIC_EMERGENCY_POLICE_NUMBER=""
NEXT_PUBLIC_EMERGENCY_FIRE_NUMBER=""

# Outbound dispatch webhook. Both values are required before any dispatch
# request is sent; without them requests stay queued and are reported as
# "not delivered" rather than accepted.
EMERGENCY_DISPATCH_WEBHOOK_URL=""
EMERGENCY_DISPATCH_WEBHOOK_SECRET=""

# Inbound secret for provider accept/decline callbacks. Unsigned callbacks are
# rejected outright.
EMERGENCY_RESPONDER_WEBHOOK_SECRET=""

# ---------------------------------------------------------------------------
# AI health assistant and private object storage — Phase 5
# ---------------------------------------------------------------------------
# Floating Sakha AI chatbot (separate from the assessment assistant below).
# The key is server-only; the endpoint defaults to BluesMinds' OpenAI-compatible
# API and the current model shown here.
BLUESMINDS_API_KEY=""
BLUESMINDS_BASE_URL="https://api.bluesminds.com/v1"
BLUESMINDS_MODEL="openai/gpt-oss-20b"
# Model used when an image is attached to Sakha. `openai/gpt-oss-20b` above is
# text-only — asked to describe an image it answers "I can't view images" — so
# image understanding needs a vision model on the same account. Verified to read
# images through POST /chat/completions. Required for the attach-a-photo flow.
BLUESMINDS_VISION_MODEL="meta/llama-3.2-11b-vision-instruct"
SAKHA_SYSTEM_PROMPT=""

# Optional server-side image search for Sakha AI. Brave Search API image
# results include provider thumbnails and source pages. Keys stay server-side.
IMAGE_SEARCH_PROVIDER=""
IMAGE_SEARCH_API_KEY=""

# AI_PROVIDER: "openai" | "bluesminds" | unset.
# Unset disables the assistant; the UI says so instead of inventing an answer.
#
# "bluesminds" reuses the BLUESMINDS_* credentials above, so the key is held
# once. That account serves chat and vision models only: audio transcription and
# document reading are reported as unavailable rather than faked.
#
# "openai" uses the official Responses API and needs AI_PROVIDER_API_KEY.
AI_PROVIDER=""
AI_PROVIDER_API_KEY=""
AI_PROVIDER_MODEL=""
# Optional model override when the configured chat model cannot read images.
# Left empty, the provider's verified vision model is used.
AI_PROVIDER_VISION_MODEL=""
AI_PROVIDER_TRANSCRIBE_MODEL=""
AI_PROVIDER_ORGANIZATION=""
AI_PROVIDER_BASE_URL=""

# Escalation policy. The red-flag floor is the lowest urgency band that may be
# returned when a warning sign is detected; it is a safety floor, not a hint.
AI_RED_FLAG_FLOOR_BAND=""
AI_REVIEW_REQUIRED_AT=""
AI_BLOCK_SHARE_UNTIL_REVIEWED=""
AI_AUTO_OFFER_EMERGENCY_ROUTE=""
AI_ALWAYS_SHOW_ENGLISH_SAFETY_LINE=""

# Retention. Days, not months. `AI_SHARE_LINK_DAYS` is the lifetime of a
# clinician-facing link, and share links are always time-limited.
AI_CONVERSATION_RETENTION_DAYS=""
AI_UPLOAD_RETENTION_DAYS=""
AI_UNSAVED_ASSESSMENT_RETENTION_DAYS=""
AI_STORE_VOICE_TRANSCRIPTS=""
AI_SHARE_LINK_DAYS=""

# Private bucket for medical media, prescriptions and claim documents. This key
# can read every patient's upload, so it stays server-side and is never
# prefixed with NEXT_PUBLIC_. Without it, uploads are recorded as unavailable.
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
AI_UPLOAD_BUCKET="orvexa-ai-uploads"

# Malware scanning endpoint. If unset, files are stored with the scan marked
# SKIPPED and the UI says the file was not scanned.
AI_MALWARE_SCAN_URL=""
AI_MALWARE_SCAN_SECRET=""

# Inbox that receives escalated AI assessments for clinical review.
AI_CLINICAL_REVIEW_INBOX=""

# Signs clinician share links. Must be at least 32 characters; there is no
# fallback, because a weak link secret is a disclosure of health data.
# Generate with: openssl rand -base64 48
AI_SHARE_LINK_SECRET=""

# ---------------------------------------------------------------------------
# Pharmacy and medicine ordering — Phase 6
# ---------------------------------------------------------------------------
# Payments. Leave RAZORPAY_KEY_ID and RAZORPAY_KEY_SECRET blank to run the
# built-in sandbox provider: it moves no money, needs no account, and stamps
# every order it touches `isSandbox` so a rehearsal can never be mistaken for a
# live sale. Setting both keys switches the platform to Razorpay, and
# `rzp_test_*` keys are recorded as test mode rather than live.
#
# RAZORPAY_WEBHOOK_SECRET is set in the Razorpay dashboard and is the only
# thing that proves a callback really came from Razorpay. Without it the webhook
# endpoint refuses every call instead of trusting an anonymous payload.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
PAYMENTS_CURRENCY="INR"

# ---------------------------------------------------------------------------
# Health insurance and claims — Phase 7
# ---------------------------------------------------------------------------
# Outbound insurer integration. When these are blank, no eligibility check or
# pre-authorisation is ever sent to an insurer: the platform falls back to a
# transparent manual workflow that issues a reference number and shows the
# request as awaiting the insurer. It never fabricates an eligibility result or
# a claim approval.
INSURER_INTEGRATION_BASE_URL=""
INSURER_INTEGRATION_API_KEY=""
INSURER_INTEGRATION_WEBHOOK_SECRET=""

# ---------------------------------------------------------------------------
# Diagnostics, laboratory reports and telemedicine — Phase 8
# ---------------------------------------------------------------------------
# Video provider for telemedicine.
#
#   VIDEO_PROVIDER="sandbox" — the built-in provider. It creates no external
#                              room and stamps every session `isSandbox`, so the
#                              booking, waiting-room and follow-up workflow can
#                              be exercised without a video account. It never
#                              reports a call connected.
#   VIDEO_PROVIDER=""        — Daily.co is used when DAILY_API_KEY is set.
#
# Leave DAILY_API_KEY blank to keep the sandbox provider. Setting it switches
# telemedicine to real rooms; a session is only ever recorded as ready or active
# once Daily confirmed the room, never on the strength of our own request.
#
# DAILY_WEBHOOK_SECRET is set in the Daily dashboard and is the only thing that
# proves a "participant joined" callback really came from Daily. Without it the
# webhook route stores the event but refuses to let it move a session.
VIDEO_PROVIDER=""
DAILY_API_KEY=""
DAILY_API_BASE_URL="https://api.daily.co/v1"
DAILY_WEBHOOK_SECRET=""

# Minutes a join link stays valid, and the window a room stays open around the
# appointment. Short by design: a consultation link that outlives the
# consultation is a standing door into a medical room.
TELEMEDICINE_JOIN_LINK_MINUTES=""
TELEMEDICINE_ROOM_GRACE_MINUTES=""

# Outbound laboratory-system (LIS) integration. When blank, a booking is never
# pushed to a partner's system: the laboratory works it from its own console and
# nothing claims the order was accepted elsewhere.
LAB_INTEGRATION_BASE_URL=""
LAB_INTEGRATION_API_KEY=""
LAB_INTEGRATION_WEBHOOK_SECRET=""

# Outbound report exchange — handing an authenticated report to another system.
# The strongest claim this can produce is transport acceptance. When blank, the
# report is exchanged through a signed patient-facing link instead.
REPORT_EXCHANGE_BASE_URL=""
REPORT_EXCHANGE_API_KEY=""
REPORT_EXCHANGE_WEBHOOK_SECRET=""
